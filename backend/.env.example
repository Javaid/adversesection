# ── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Security ──────────────────────────────────────────────────────────────────
JWT_SECRET=replace_this_with_a_long_random_secret_at_least_64_chars
JWT_EXPIRES_IN=7d

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:5174

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Trust one reverse proxy hop (set false if app is directly internet-facing).
TRUST_PROXY=1

# ── MSSQL / Sequelize ────────────────────────────────────────────────────────
DB_ENABLED=false
DB_HOST=localhost
DB_PORT=1433
DB_NAME=adverse_section
DB_USER=sa
DB_PASSWORD=your_password
DB_ENCRYPT=true
DB_TRUST_SERVER_CERT=true
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_IDLE=10000
DB_POOL_ACQUIRE=30000
